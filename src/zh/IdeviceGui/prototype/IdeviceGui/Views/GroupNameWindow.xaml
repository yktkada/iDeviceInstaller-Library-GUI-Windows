<Window x:Class="IdeviceGui.Views.GroupNameWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="分组名称" Icon="/app.ico" Width="320" Height="150"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="分组名称：" />
        <TextBox x:Name="NameBox" Grid.Row="1" Margin="0,4,0,0" Padding="4,3" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" Width="78" Padding="0,3" IsDefault="True" Click="OnOk" />
            <Button Content="取消" Width="78" Padding="0,3" Margin="8,0,0,0"
                    IsCancel="True" Click="OnCancel" />
        </StackPanel>
    </Grid>
</Window>
