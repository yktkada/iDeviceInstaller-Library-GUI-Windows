<Window x:Class="IdeviceGui.Views.SettingsWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Icon="/app.ico" Width="620" Height="660" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        AutomationProperties.AutomationId="SettingsWindow">
    <!-- 生效方式（2026-11-02 用户定）：窗口内即时预览，点「确定 / 应用」才写库，「取消 / 关窗」回滚。
         例外（2026-11-03 审查 N2）：扫描根添加/删除、列宽复位是**立即生效的动作**，不受「取消」影响。 -->
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="GroupResetButton" TargetType="Button">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="OkButton" Content="确定" Width="76" Padding="0,3" Click="OnOkClick" IsDefault="True" />
            <Button x:Name="ApplyButton" Content="应用" Width="76" Padding="0,3" Margin="8,0,0,0" Click="OnApplyClick" />
            <Button x:Name="CancelButton" Content="取消" Width="76" Padding="0,3" Margin="8,0,0,0" Click="OnCancelClick" IsCancel="True" />
        </StackPanel>

        <TabControl x:Name="Tabs" AutomationProperties.AutomationId="SettingsTabs">
            <!-- 资料库 -->
            <TabItem Header="资料库">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>
                        <Button Content="恢复默认" Style="{StaticResource GroupResetButton}" Tag="Library" Click="OnResetGroupClick" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="网格行高（DIP）" Style="{StaticResource RowLabel}" />
                            <Slider x:Name="RowHeightSlider" Grid.Column="1" Minimum="16" Maximum="48"
                                    TickFrequency="2" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    ValueChanged="OnRowHeightSliderChanged" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBox x:Name="RowHeightBox" Width="52" TextChanged="OnAnyChanged" LostFocus="OnNumericLostFocus"
                                         ToolTip="16–48 DIP；默认 32（非法输入失焦后回填合法值）" />
                                <TextBlock Text="DIP" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="搜索延迟阈值（行数）" Style="{StaticResource RowLabel}" />
                            <TextBox x:Name="SearchRowsBox" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                                     TextChanged="OnAnyChanged" LostFocus="OnNumericLostFocus"
                                     ToolTip="显示行数大于该值才启用搜索防抖；0–200000，默认 1000" />
                            <TextBlock Grid.Column="2" Text="行" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="搜索延迟（ms）" Style="{StaticResource RowLabel}" />
                            <TextBox x:Name="SearchDelayBox" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                                     TextChanged="OnAnyChanged" LostFocus="OnNumericLostFocus"
                                     ToolTip="0–5000，默认 200；0 = 不等待" />
                            <TextBlock Grid.Column="2" Text="ms" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="默认排序" Style="{StaticResource RowLabel}" />
                            <ComboBox x:Name="SortFieldCombo" Grid.Column="1" SelectionChanged="OnAnyChanged" />
                            <CheckBox x:Name="SortDescendingCheck" Grid.Column="2" Content="降序"
                                      VerticalAlignment="Center" Margin="8,0,0,0" Click="OnAnyChanged" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="搜索匹配方式" Style="{StaticResource RowLabel}" />
                            <ComboBox x:Name="MatchModeCombo" Grid.Column="1" SelectionChanged="OnAnyChanged" />
                        </Grid>
                        <TextBlock Text="搜索范围（列）" Style="{StaticResource SectionTitle}" />
                        <WrapPanel x:Name="ScopePanel" Orientation="Horizontal" />
                        <TextBlock Text="行为" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="MergeCheck" Content="合并同 BundleId" Margin="0,2,0,2" Click="OnAnyChanged" />
                        <CheckBox x:Name="MissingCheck" Content="显示不存在的文件" Margin="0,2,0,2" Click="OnAnyChanged" />
                        <CheckBox x:Name="DeviceFamilyRetinaCheck" Content="设备族用 Retina 文案（关 = 用 R）" Margin="0,8,0,2" Click="OnAnyChanged" />
                        <TextBlock Text="列显示" Style="{StaticResource SectionTitle}" />
                        <WrapPanel x:Name="ColumnsPanel" Orientation="Horizontal" />
                        <Button Content="管理分组…" Padding="10,3" HorizontalAlignment="Left"
                                Margin="0,12,0,0" Click="OnManageGroupsSettingsClick" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 扫描 -->
            <TabItem Header="扫描">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>
                        <Button Content="恢复默认" Style="{StaticResource GroupResetButton}" Tag="Scan" Click="OnResetGroupClick" />
                        <TextBlock Text="扫描根（RootN）" Style="{StaticResource SectionTitle}" />
                        <ListBox x:Name="RootsList" Height="180" AutomationProperties.AutomationId="SettingsRootsList" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="添加目录…" Padding="10,3" Click="OnAddRootClick"
                                    ToolTip="立即生效：添加即写库并立刻扫描，不受「取消」影响" />
                            <Button Content="删除选中" Padding="10,3" Margin="8,0,0,0" Click="OnDeleteRootClick"
                                    ToolTip="立即生效：会同时删掉该根下的包行并立刻扫描，不受「取消」影响" />
                            <TextBlock x:Name="RootsHint" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#FF666666" />
                        </StackPanel>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="分批落库行数" Style="{StaticResource RowLabel}" />
                            <TextBox x:Name="BatchSizeBox" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                                     TextChanged="OnAnyChanged" LostFocus="OnNumericLostFocus"
                                     ToolTip="1–1000；默认 30（非法输入失焦后回填合法值）" />
                        </Grid>
                        <TextBlock Text="说明：添加/删除扫描根会立刻重扫；删除会把该根下的包行从库里删掉。这两个动作立即生效，不受「取消」影响。"
                                   Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FF666666" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 图标 -->
            <TabItem Header="图标">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>
                        <Button Content="恢复默认" Style="{StaticResource GroupResetButton}" Tag="Icons" Click="OnResetGroupClick" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="图标缓存上限（MB）" Style="{StaticResource RowLabel}" />
                            <TextBox x:Name="CacheMaxBox" Grid.Column="1" Width="110" HorizontalAlignment="Left"
                                     TextChanged="OnAnyChanged" LostFocus="OnNumericLostFocus"
                                     ToolTip="默认 2048；64–20480（非法输入失焦后回填合法值）" />
                        </Grid>
                        <CheckBox x:Name="IconMatchScaleCheck" Content="按缩放取最小的够用尺寸"
                                  Margin="0,10,0,2" Click="OnAnyChanged" />
                        <CheckBox x:Name="IconDownscaleCheck" Content="落盘时缩到缓存档位（关掉存原尺寸，磁盘会变大）"
                                  Margin="0,2,0,2" Click="OnAnyChanged" />
                        <TextBlock x:Name="IconBucketHint" Margin="0,10,0,0" Foreground="#FF666666" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 日志 -->
            <TabItem Header="日志">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>
                        <Button Content="恢复默认" Style="{StaticResource GroupResetButton}" Tag="Log" Click="OnResetGroupClick" />
                        <CheckBox x:Name="LogToFileCheck" Content="写文件日志 logs\app.log（默认关；crash.log 始终写）"
                                  Margin="0,6,0,2" Click="OnAnyChanged" />
                        <CheckBox x:Name="LogDetailCheck" Content="日志面板：详细模式（默认简洁）"
                                  Margin="0,2,0,2" Click="OnAnyChanged" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 布局 -->
            <TabItem Header="布局">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>
                        <Button Content="恢复默认" Style="{StaticResource GroupResetButton}" Tag="Layout" Click="OnResetGroupClick" />
                        <CheckBox x:Name="LogHiddenCheck" Content="隐藏日志栏" Margin="0,6,0,2" Click="OnAnyChanged" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="最大化日志浮层宽度" Style="{StaticResource RowLabel}" />
                            <TextBox x:Name="OverlayWidthBox" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                                     TextChanged="OnAnyChanged" LostFocus="OnNumericLostFocus"
                                     ToolTip="260–900；默认 420（非法输入失焦后回填合法值）" />
                        </Grid>
                        <Button Content="恢复默认三栏比例" Padding="10,3" Margin="0,14,0,0" HorizontalAlignment="Left"
                                Click="OnResetColumnsClick"
                                ToolTip="立即生效：不受「取消」影响" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 设备 -->
            <TabItem Header="设备">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>
                        <Button Content="恢复默认" Style="{StaticResource GroupResetButton}" Tag="Device" Click="OnResetGroupClick" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="在线轮询间隔（秒）" Style="{StaticResource RowLabel}" />
                            <TextBox x:Name="PollSecondsBox" Grid.Column="1" Width="70" HorizontalAlignment="Left"
                                     TextChanged="OnAnyChanged" LostFocus="OnNumericLostFocus"
                                     ToolTip="1–10；默认 2（非法输入失焦后回填合法值）" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="联机稳定窗口（秒）" Style="{StaticResource RowLabel}" />
                            <TextBox x:Name="StableSecondsBox" Grid.Column="1" Width="70" HorizontalAlignment="Left"
                                     TextChanged="OnAnyChanged" LostFocus="OnNumericLostFocus"
                                     ToolTip="1–10；默认 3；期间再次断开则重新计时" />
                        </Grid>
                        <CheckBox x:Name="AutoResumeCheck" Content="联机稳定后自动继续（默认开）" Margin="0,10,0,2" Click="OnAnyChanged" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="失败后自动尝试次数" Style="{StaticResource RowLabel}" />
                            <TextBox x:Name="AutoRetryAttemptsBox" Grid.Column="1" Width="70" HorizontalAlignment="Left"
                                     TextChanged="OnAnyChanged" LostFocus="OnNumericLostFocus"
                                     ToolTip="2–5；默认 2（含首次）；每次失败后自动再入队一条，达到次数后终判失败" />
                        </Grid>
                        <TextBlock Text="设备信息字段（顺序 / 显示）" Style="{StaticResource SectionTitle}" />
                        <ListBox x:Name="FieldsList" Height="180" AutomationProperties.AutomationId="SettingsFieldsList">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding Visible, Mode=TwoWay}"
                                              Checked="OnFieldCheckChanged" Unchecked="OnFieldCheckChanged" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="上移" Padding="10,3" Click="OnFieldUpClick" />
                            <Button Content="下移" Padding="10,3" Margin="8,0,0,0" Click="OnFieldDownClick" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 关于：固定英文，不参与应用 / 取消 / 恢复默认（2026-11-08） -->
            <TabItem Header="关于">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>
                        <TextBlock Text="iDeviceInstaller+Library GUI For Windows"
                                   FontSize="16" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="IPA Library &amp; Installer for Legacy iOS Devices"
                                   Margin="0,4,0,12" Foreground="#FF555555" TextWrapping="Wrap" />
                        <TextBlock TextWrapping="Wrap" LineHeight="20">
                            A powerful IPA library manager and installer for legacy iOS devices on Windows.
                        </TextBlock>
                        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="20">
                            Performance-tested with a 50,000+ IPA library.
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" LineHeight="20">Advanced compatibility filtering.</TextBlock>
                        <TextBlock TextWrapping="Wrap" LineHeight="20">Intelligent multi-device installation queues.</TextBlock>
                        <TextBlock x:Name="AboutVersionText" Margin="0,16,0,0" TextWrapping="Wrap" />
                        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="20">
                            Supported: iOS 4 / 6 / 7 / 8 and iPad.
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" LineHeight="20">Newer iOS devices are not officially supported.</TextBlock>
                        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="20">
                            Unofficial third-party tool. Not affiliated with Apple Inc.
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
