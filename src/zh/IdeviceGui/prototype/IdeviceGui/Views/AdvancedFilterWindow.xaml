<Window x:Class="IdeviceGui.Views.AdvancedFilterWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="高级筛选" Width="780" Height="640" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        AutomationProperties.AutomationId="AdvancedFilterWindow" Icon="/app.ico">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="组内统一用「且 / 或」，组间固定为「且」；已勾选的列不能重复。" VerticalAlignment="Center" Foreground="#FF666666" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="清除全部" Padding="10,3" Click="OnClearAllClick" />
            <Button Content="添加组" Padding="10,3" Margin="8,0,0,0" Click="OnAddGroupClick" />
            <Button Content="应用" Width="76" Padding="0,3" Margin="16,0,0,0" IsDefault="True" Click="OnApplyClick" />
            <Button Content="取消" Width="76" Padding="0,3" Margin="8,0,0,0" IsCancel="True" Click="OnCancelClick" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="GroupsPanel" />
        </ScrollViewer>
    </DockPanel>
</Window>
