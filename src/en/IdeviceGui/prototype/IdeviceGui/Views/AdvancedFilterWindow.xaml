<Window x:Class="IdeviceGui.Views.AdvancedFilterWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Advanced filter" Width="780" Height="640" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        AutomationProperties.AutomationId="AdvancedFilterWindow" Icon="/app.ico">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Within a group use AND / OR; groups are always combined with AND. Each column can only be selected once." VerticalAlignment="Center" Foreground="#FF666666" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Clear all" Padding="10,3" Click="OnClearAllClick" />
            <Button Content="Add group" Padding="10,3" Margin="8,0,0,0" Click="OnAddGroupClick" />
            <Button Content="Apply" Width="76" Padding="0,3" Margin="16,0,0,0" IsDefault="True" Click="OnApplyClick" />
            <Button Content="Cancel" Width="76" Padding="0,3" Margin="8,0,0,0" IsCancel="True" Click="OnCancelClick" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="GroupsPanel" />
        </ScrollViewer>
    </DockPanel>
</Window>
